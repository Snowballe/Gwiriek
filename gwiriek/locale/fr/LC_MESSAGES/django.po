#, python-format
msgid "Unknown inspector type %(kind)s."
msgstr "Type de vérificateur %(kind)s inconnu."

#, python-format
msgid "No person with id %(id)s."
msgstr "Aucune personne avec l'id %(id)s."

msgid "This person is already an inspector."
msgstr "Cette personne est déjà vérificateur."

msgid "This inspector is inactive."
msgstr "Ce vérificateur est inactif."

msgid "This inspector is no longer one of the active people."
msgstr "Ce vérificateur ne fait plus partie des personnes actives."

msgid "This inspector has no written authorization."
msgstr "Ce vérificateur n'a pas d'habilitation écrite."

#, python-format
msgid "This inspector's authorization starts after %(date)s."
msgstr "L'habilitation de ce vérificateur commence après le %(date)s."

#, python-format
msgid "This inspector's authorization was no longer valid on %(date)s."
msgstr "L'habilitation de ce vérificateur n'était plus valable le %(date)s."

