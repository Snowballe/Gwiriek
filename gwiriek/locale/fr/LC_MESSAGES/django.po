msgstr "Organisme"

msgid "Authorization date"
msgstr "Date d'habilitation"

#, python-format
msgid "Qualified on %(date)s"
msgstr "Habilité le %(date)s"

msgid "An item id must be a number."
msgstr "Un id d'article doit être un nombre."

