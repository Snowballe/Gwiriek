#, python-format
msgid "Unknown assignment target %(kind)s."
msgstr "Type d'affectation inconnu : %(kind)s."

msgid "A retired item cannot be assigned."
msgstr "Un article rebuté ne peut pas être affecté."

msgid "A quarantined item cannot be issued."
msgstr "Un article en quarantaine ne peut pas être remis en dotation."

msgid "This item has passed its end of life and cannot be issued."
msgstr ""
"Cet article a dépassé sa fin de vie et ne peut pas être remis en dotation."

msgid "Choose the person to assign the item to."
msgstr "Choisissez la personne à qui affecter l'article."

msgid "This person is no longer active."
msgstr "Cette personne n'est plus active."

msgid "A person can only be given for a person assignment."
msgstr ""
"Une personne ne peut être indiquée que pour une affectation à une personne."

msgid "Enter the site name."
msgstr "Indiquez le nom du chantier."

msgid "An assignment cannot start in the future."
msgstr "Une affectation ne peut pas commencer dans le futur."

#, python-format
msgid "The new assignment cannot start before the current one (%(date)s)."
msgstr ""
"La nouvelle affectation ne peut pas commencer avant l'affectation en cours "
"(%(date)s)."

msgid "Issued"
msgstr "Remis en dotation"

msgid "Returned to stock"
msgstr "Remis en stock"

#, python-format
msgid "No manufacturer with id %(ref)s."
msgstr "Aucun fabricant avec l'id %(ref)s."

#, python-format
msgid "No manufacturer named %(ref)s."
msgstr "Aucun fabricant nommé %(ref)s."

#, python-format
msgid "Unknown family %(family)s."
msgstr "Famille inconnue : %(family)s."

#, python-format
msgid "No product model with id %(id)s."
msgstr "Aucun modèle avec l'id %(id)s."

msgid "The number of days cannot be negative."
msgstr "Le nombre de jours ne peut pas être négatif."

msgid "Indicative: to be confirmed against the manufacturer's instructions."
msgstr "À titre indicatif : à confirmer selon la notice du fabricant."

#, python-format
msgid "Unknown result %(result)s for %(point)s."
msgstr "Résultat %(result)s inconnu pour %(point)s."

msgid "A checklist point is given twice."
msgstr "Un point de contrôle est donné deux fois."

#, python-format
msgid "%(point)s is not a point of this model's checklist."
msgstr "%(point)s n'est pas un point de contrôle de ce modèle."

#, python-format
msgid "The point %(point)s is given twice."
msgstr "Le point %(point)s est donné deux fois."

#, python-format
msgid "Every checklist point needs a result; missing: %(points)s."
msgstr ""
"Chaque point de contrôle doit avoir un résultat ; manquants : %(points)s."

#, python-format
msgid "Unknown decision %(decision)s."
msgstr "Décision %(decision)s inconnue."

msgid "A retired item cannot be inspected."
msgstr "Un article rebuté ne peut pas être vérifié."

msgid "An inspection cannot be dated in the future."
msgstr "Une vérification ne peut pas être datée dans le futur."

msgid "This date is in the future."
msgstr "Cette date est dans le futur."

msgid "An inspection cannot be dated before the date of manufacture."
msgstr ""
"Une vérification ne peut pas être antérieure à la date de fabrication."

msgid "This date is before the date of manufacture."
msgstr "Cette date est antérieure à la date de fabrication."

#, python-format
msgid ""
"The item's latest inspection is dated %(date)s; a new one cannot be earlier."
msgstr ""
"La dernière vérification de l'article date du %(date)s ; une nouvelle ne "
"peut pas être antérieure."

msgid "Earlier than the latest inspection."
msgstr "Antérieure à la dernière vérification."

#, python-format
msgid ""
"A point is not compliant (%(points)s): the item can only be quarantined or "
"retired."
msgstr ""
"Un point n'est pas conforme (%(points)s) : l'article ne peut qu'être mis en "
"quarantaine ou rebuté."

msgid ""
"This item has passed its end of life: it can only be quarantined or retired."
msgstr ""
"Cet article a dépassé sa fin de vie : il ne peut qu'être mis en quarantaine "
"ou rebuté."

#, python-format
msgid "A comment is required for the decision %(decision)s."
msgstr "Un commentaire est obligatoire pour la décision %(decision)s."

msgid "Explain the decision."
msgstr "Expliquez la décision."

msgid "This model has no checklist: describe what was checked in the comment."
msgstr ""
"Ce modèle n'a pas de points de contrôle : décrivez ce qui a été vérifié dans"
" le commentaire."

msgid "Describe what was checked."
msgstr "Décrivez ce qui a été vérifié."

msgid "The report cannot be received before the inspection or in the future."
msgstr ""
"Le rapport ne peut pas être reçu avant la vérification ni dans le futur."

msgid "Invalid date."
msgstr "Date invalide."

msgid ""
"For an external inspector, attach the report or give the date it was "
"received and where it is archived."
msgstr ""
"Pour un vérificateur externe, joignez le rapport ou indiquez sa date de "
"réception et son lieu d'archivage."

msgid "Attach the report or give its archive details."
msgstr "Joignez le rapport ou indiquez où il est archivé."

msgid "A retired item has no next inspection."
msgstr "Un article rebuté n'a pas de prochaine vérification."

#, python-format
msgid ""
"The next inspection must be after the inspection and no later than %(date)s."
msgstr ""
"La prochaine vérification doit suivre la vérification et au plus tard le "
"%(date)s."

msgid "The actor of a change is required."
msgstr "L'auteur du changement est obligatoire."

#, python-format
msgid "Inspection of %(date)s: %(decision)s."
msgstr "Vérification du %(date)s : %(decision)s."

#, python-format
msgid "No inspection with id %(id)s."
msgstr "Aucune vérification avec l'id %(id)s."

#, python-format
msgid "No inspector with id %(id)s."
msgstr "Aucun vérificateur avec l'id %(id)s."

msgid "An internal inspector is one of the company's people."
msgstr "Un vérificateur interne est une personne de l'entreprise."

msgid "Name and organisation are for external inspectors only."
msgstr "Le nom et l'organisme sont réservés aux vérificateurs externes."

msgid "An external inspector is not one of the company's people."
msgstr "Un vérificateur externe n'est pas une personne de l'entreprise."

msgid "Enter the name of the external inspector."
msgstr "Indiquez le nom du vérificateur externe."

msgid "Choose internal or external."
msgstr "Choisissez interne ou externe."

msgid "A written authorization needs a reference or an attached document."
msgstr ""
"Une habilitation écrite doit avoir une référence ou un document joint."

msgid "Enter the authorization date first."
msgstr "Indiquez d'abord la date d'habilitation."

msgid "The validity ends before the authorization."
msgstr "La validité se termine avant l'habilitation."

#, python-format
msgid "Unknown family: %(values)s."
