# Gwiriek configuration. Copy to .env and load it with: uv run --env-file .env gwiriek ...

# Secret key for admin sessions. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
GWIRIEK_SECRET_KEY=

# Never enable on a server reachable by others.
GWIRIEK_DEBUG=false

# Comma-separated host names the admin is served on.
GWIRIEK_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins, needed behind HTTPS, e.g. https://epi.example.org
GWIRIEK_CSRF_TRUSTED_ORIGINS=

# SQLite (default, relative paths are resolved from the project directory):
GWIRIEK_DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (install with: uv sync --extra postgres):
# GWIRIEK_DATABASE_URL=postgresql://gwiriek:password@localhost:5432/gwiriek

GWIRIEK_LANGUAGE_CODE=fr
GWIRIEK_TIME_ZONE=Europe/Paris

# Uploaded attachments and collected static files.
# GWIRIEK_MEDIA_ROOT=/var/lib/gwiriek/media
# GWIRIEK_STATIC_ROOT=/var/lib/gwiriek/static

# E-mail. The default console backend prints messages instead of sending them.
# GWIRIEK_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# GWIRIEK_EMAIL_HOST=smtp.example.org
# GWIRIEK_EMAIL_PORT=587
# GWIRIEK_EMAIL_HOST_USER=
# GWIRIEK_EMAIL_HOST_PASSWORD=
# GWIRIEK_EMAIL_USE_TLS=true
# GWIRIEK_DEFAULT_FROM_EMAIL=gwiriek@example.org

# Comma-separated addresses receiving the digest of due items (gwiriek notify).
GWIRIEK_ALERT_RECIPIENTS=
